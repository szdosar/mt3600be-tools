#!/bin/sh /etc/rc.common
START=99
STOP=10
USE_PROCD=1
start_service() {
 [ -f /etc/mt3600be-wan-eee/installed ] || return 0
 [ ! -e /etc/mt3600be-wan-eee/disabled ] || return 0
 procd_open_instance
 procd_set_param command /usr/sbin/mt3600be-wan-eee run
 procd_set_param respawn 3600 30 5
 procd_set_param stdout 0
 procd_set_param stderr 1
 procd_close_instance
}
